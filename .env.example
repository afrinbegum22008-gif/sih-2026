# Server & Database Configuration
PORT=5000
NODE_ENV=development
DATABASE_URL=file:./server/data/db.json
AUTH_SECRET=mospi_capacity_building_sso_secret_2026

# AI Provider Configuration (OpenAI Backend Service)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# iGOT Karmayogi Official Integration Architecture
# Official Portal: https://www.igotkarmayogi.gov.in/
# To enable live API synchronization, configure department credentials issued by Karmayogi Bharat
IGOT_BASE_URL=https://www.igotkarmayogi.gov.in
IGOT_API_BASE_URL=https://api.igotkarmayogi.gov.in/v1
IGOT_CLIENT_ID=
IGOT_CLIENT_SECRET=
IGOT_API_KEY=
IGOT_REDIRECT_URI=http://localhost:5173/auth/igot/callback

# NSSTA / TPAC Training Academy Integration Architecture
# Official Portal: https://www.nssta.gov.in/
# National Statistical Systems Training Academy (MoSPI), Greater Noida
NSSTA_BASE_URL=https://www.nssta.gov.in
NSSTA_API_BASE_URL=https://api.nssta.gov.in/v1
